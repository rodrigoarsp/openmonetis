# ============================================
# OPENMONETIS - Produção (financas.rodrigors.online)
# Copie para .env.production e preencha. NUNCA commitar o arquivo real.
# ============================================

# Porta publicada no servidor; é a que o Cloudflare Tunnel deve apontar.
APP_PORT=3210

# === Database (PostgreSQL do próprio compose) ===
# A DATABASE_URL do app é montada pelo compose a partir destas variáveis.
# Gere a senha com: openssl rand -hex 24 (evite caracteres especiais).
POSTGRES_USER=openmonetis
POSTGRES_PASSWORD=
POSTGRES_DB=openmonetis_db

# === Better Auth ===
# Gere um segredo NOVO para produção: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://financas.rodrigors.online
BETTER_AUTH_TRUSTED_ORIGINS=https://financas.rodrigors.online

# Deixe false só até criar sua conta; depois mude para true para bloquear novos cadastros.
DISABLE_SIGNUP=false

AUTH_SESSION_EXPIRES_IN_DAYS=30
AUTH_SESSION_UPDATE_AGE_HOURS=24

# === OAuth Google (opcional) ===
# Redirect URI a cadastrar: https://financas.rodrigors.online/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email (opcional) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL="OpenMonetis <noreply@rodrigors.online>"

# === S3 (opcional, anexos) ===
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# === IA / Logo.dev (opcional) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
LOGO_DEV_TOKEN=
LOGO_DEV_SECRET_KEY=
